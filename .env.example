# ──────────────────────────────────────────────────────────────────────────────
# DTR Extension Shopify — Environment Variables
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit the real .env file to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ── Supabase ─────────────────────────────────────────────────────────────────
# From your Supabase project dashboard → Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Shopify ──────────────────────────────────────────────────────────────────
# API secret from your Shopify Partners Dashboard → App → Client credentials
SHOPIFY_API_SECRET=shpss_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── AI / LLM — DeepSeek (OpenAI-compatible) ─────────────────────────────────
# Get your key at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ── App settings ─────────────────────────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=info